  "description": "MFC — My Finance Control | Projeto de Testes de Software",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.cjs",
    "test": "node --test tests/unit.test.cjs tests/integration.test.cjs",
